   "id": "95e8a3f5",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import mean_squared_error\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.neural_network import MLPRegressor\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "from sklearn.gaussian_process import GaussianProcessRegressor\n",
    "from sklearn.gaussian_process.kernels import RBF, ConstantKernel as C, WhiteKernel\n",
    "from scipy.interpolate import Rbf"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 73,
   "id": "5d3434d4",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = np.loadtxt('/heatsink.txt')\n",
    "\n",
    "G1 = data[:, :1]\n",
    "G2 = data[:, 1:2]\n",
    "TR = data[:, 2:3]\n",
    "PD = data[:, 3:4]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 74,
   "id": "2c63e95a",
   "metadata": {},
   "outputs": [],
   "source": [
    "X = np.hstack((G1, G2))\n",
    "Y = np.hstack((TR, PD))\n",
    "\n",
    "X_train, X_test, Y_train, Y_test = train_test_split(\n",
    "    X, Y, test_size=0.2, random_state=42\n",
    ")\n",
    "\n",
    "ytr_train = Y_train[:, 0]\n",
    "ypd_train = Y_train[:, 1]\n",
    "ytr_test = Y_test[:, 0]\n",
    "ypd_test = Y_test[:, 1]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 75,
   "id": "d7620fa1",
   "metadata": {},
   "outputs": [],
   "source": [
    "models = {\n",
    "    \"Kriging\": Pipeline([\n",
    "        (\"scaler\", StandardScaler()),\n",
    "        (\"model\", GaussianProcessRegressor(\n",
    "            kernel=C(1.0) * RBF(length_scale=1.0) + WhiteKernel(noise_level=1e-6),\n",
    "            normalize_y=True,\n",
    "            random_state=42\n",
    "        ))\n",
    "    ]),\n",
    "    \"RBF Linear\": \"rbf_linear\",\n",
    "    \"RBF Multiquadric\": \"rbf_multiquadric\",\n",
    "    \"RBF Inverse Multiquadric\": \"rbf_inverse_multiquadric\",\n",
    "    \"Neural Network\": Pipeline([\n",
    "        (\"scaler\", StandardScaler()),\n",
    "        (\"model\", MLPRegressor(hidden_layer_sizes=(64, 64), max_iter=5000, random_state=42))\n",
    "    ]),\n",
    "    \"Random Forest\": RandomForestRegressor(n_estimators=300, random_state=42)\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 76,
   "id": "967b6725",
   "metadata": {},
   "outputs": [],
   "source": [
    "def rbf_predict(X_train, y_train, X_test, function_name):\n",
    "    rbf = Rbf(X_train[:, 0], X_train[:, 1], y_train, function=function_name)\n",
    "    return rbf(X_test[:, 0], X_test[:, 1])\n",
    "\n",
    "def get_rbf_function(name):\n",
    "    func_map = {\n",
    "        \"RBF Linear\": \"linear\",\n",
    "        \"RBF Multiquadric\": \"multiquadric\",\n",
    "        \"RBF Inverse Multiquadric\": \"inverse_multiquadric\"\n",
    "    }\n",
    "    return func_map[name]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 77,
   "id": "ad25f4b1",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "\n"
     ]
    }
   ],
   "source": [
    "results = []\n",
     ]
    }
   ],
   "source": [
    "results = []\n",
    "predictions = {}\n",
    "\n",
    "for name, model in models.items():\n",
    "    if name.startswith(\"RBF\"):\n",
    "        func = get_rbf_function(name)\n",
    "        pred_tr = rbf_predict(X_train, ytr_train, X_test, func)\n",
    "        pred_pd = rbf_predict(X_train, ypd_train, X_test, func)\n",
    "    else:\n",
    "        model.fit(X_train, ytr_train)\n",
    "        pred_tr = model.predict(X_test)\n",
    "\n",
    "        model.fit(X_train, ypd_train)\n",
    "        pred_pd = model.predict(X_test)\n",
    "\n",
    "    rmse_tr = np.sqrt(mean_squared_error(ytr_test, pred_tr))\n",
    "    rmse_pd = np.sqrt(mean_squared_error(ypd_test, pred_pd))\n",
    "\n",
    "    results.append({\n",
    "        \"Model\": name,\n",
    "        \"RMSE_TR\": rmse_tr,\n",
    "        \"RMSE_PD\": rmse_pd,\n",
    "        \"Mean_RMSE\": (rmse_tr + rmse_pd) / 2\n",
    "    })\n",
    "\n",
    "    predictions[name] = {\n",
    "        \"TR_true\": ytr_test,\n",
    "        \"TR_pred\": pred_tr,\n",
    "        \"PD_true\": ypd_test,\n",
    "        \"PD_pred\": pred_pd\n",
    "    }"
   ]
  },
